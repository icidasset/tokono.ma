module Resume exposing
    ( CareerItem
    , ExternalLink
    , Language
    , Profile
    , Project
    , decoder
    , encode
    , empty
    )

{-| The shape of the résumé as it's rendered on the `/resume` page.

This is the display-ready data model — everything the AT Protocol needs in
order to be shown (label mapping, sorting, date formatting, …) has already been
resolved by [`ResumeBuilder`](#) when the data was synced into `data/resume.json`.
The views only read this type.

@docs Profile, CareerItem, Language, Project, ExternalLink, decoder, encode, empty
-}

import Json.Decode as Json
import Json.Encode


type alias Profile =
    { name : String
    , about : String
    , location : Maybe String
    , career : Array CareerItem
    , skills : Array String
    , languages : Array Language
    , projects : Array Project
    , externals : Array ExternalLink
    }


type alias CareerItem =
    { title : String
    , dates : String
    , meta : Maybe String
    , description : Maybe String
    , skills : Array String
    }


type alias Language =
    { name : String
    , proficiency : Maybe String
    }


type alias Project =
    { title : String
    , url : Maybe String
    , dates : Maybe String
    , description : Maybe String
    }


type alias ExternalLink =
    { label : String
    , url : String
    }


empty : Profile
empty =
    { name = "@tokono.ma"
    , about = ""
    , location = Nothing
    , career = []
    , skills = []
    , languages = []
    , projects = []
    , externals = []
    }



-- 📦  JSON


{-| Read a `Profile` back from the JSON stored in `data/resume.json`.
-}
decoder : Json.Decoder Profile
decoder =
    Json.map8
        (\name about location career skills languages projects externals ->
            { name = name
            , about = about
            , location = location
            , career = career
            , skills = skills
            , languages = languages
            , projects = projects
            , externals = externals
            }
        )
        (Json.field "name" Json.string)
        (Json.field "about" Json.string)
        (Json.maybe (Json.field "location" Json.string))
        (Json.field "career" (Json.array careerItemDecoder))
        (Json.field "skills" (Json.array Json.string))
        (Json.field "languages" (Json.array languageDecoder))
        (Json.field "projects" (Json.array projectDecoder))
        (Json.field "externals" (Json.array externalLinkDecoder))


careerItemDecoder : Json.Decoder CareerItem
careerItemDecoder =
    Json.map5
        (\title dates meta description skills ->
            { title = title
            , dates = dates
            , meta = meta
            , description = description
            , skills = skills
            }
        )
        (Json.field "title" Json.string)
        (Json.field "dates" Json.string)
        (Json.maybe (Json.field "meta" Json.string))
        (Json.maybe (Json.field "description" Json.string))
        (Json.field "skills" (Json.array Json.string))


languageDecoder : Json.Decoder Language
languageDecoder =
    Json.map2
        (\name proficiency -> { name = name, proficiency = proficiency })
        (Json.field "name" Json.string)
        (Json.maybe (Json.field "proficiency" Json.string))


projectDecoder : Json.Decoder Project
projectDecoder =
    Json.map4
        (\title url dates description ->
            { title = title
            , url = url
            , dates = dates
            , description = description
            }
        )
        (Json.field "title" Json.string)
        (Json.maybe (Json.field "url" Json.string))
        (Json.maybe (Json.field "dates" Json.string))
        (Json.maybe (Json.field "description" Json.string))


externalLinkDecoder : Json.Decoder ExternalLink
externalLinkDecoder =
    Json.map2
        (\label url -> { label = label, url = url })
        (Json.field "label" Json.string)
        (Json.field "url" Json.string)


{-| Store a `Profile` as JSON, the format written to `data/resume.json` by the
sync task (`just sync-resume`).
-}
encode : Profile -> Json.Encode.Value
encode profile =
    Json.Encode.object
        [ { key = "name", value = Json.Encode.string profile.name }
        , { key = "about", value = Json.Encode.string profile.about }
        , { key = "location", value = maybeValue (Maybe.map Json.Encode.string profile.location) }
        , { key = "career", value = Json.Encode.array encodeCareerItem profile.career }
        , { key = "skills", value = Json.Encode.array Json.Encode.string profile.skills }
        , { key = "languages", value = Json.Encode.array encodeLanguage profile.languages }
        , { key = "projects", value = Json.Encode.array encodeProject profile.projects }
        , { key = "externals", value = Json.Encode.array encodeExternalLink profile.externals }
        ]


encodeCareerItem : CareerItem -> Json.Encode.Value
encodeCareerItem item =
    Json.Encode.object
        [ { key = "title", value = Json.Encode.string item.title }
        , { key = "dates", value = Json.Encode.string item.dates }
        , { key = "meta", value = maybeValue (Maybe.map Json.Encode.string item.meta) }
        , { key = "description", value = maybeValue (Maybe.map Json.Encode.string item.description) }
        , { key = "skills", value = Json.Encode.array Json.Encode.string item.skills }
        ]


encodeLanguage : Language -> Json.Encode.Value
encodeLanguage lang =
    Json.Encode.object
        [ { key = "name", value = Json.Encode.string lang.name }
        , { key = "proficiency", value = maybeValue (Maybe.map Json.Encode.string lang.proficiency) }
        ]


encodeProject : Project -> Json.Encode.Value
encodeProject project =
    Json.Encode.object
        [ { key = "title", value = Json.Encode.string project.title }
        , { key = "url", value = maybeValue (Maybe.map Json.Encode.string project.url) }
        , { key = "dates", value = maybeValue (Maybe.map Json.Encode.string project.dates) }
        , { key = "description", value = maybeValue (Maybe.map Json.Encode.string project.description) }
        ]


encodeExternalLink : ExternalLink -> Json.Encode.Value
encodeExternalLink link =
    Json.Encode.object
        [ { key = "label", value = Json.Encode.string link.label }
        , { key = "url", value = Json.Encode.string link.url }
        ]


maybeValue : Maybe Json.Encode.Value -> Json.Encode.Value
maybeValue maybe =
    when maybe is
        Just value ->
            value

        Nothing ->
            Json.Encode.null
