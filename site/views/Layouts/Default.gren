module Layouts.Default exposing ( layout )

import Json.Decode
import Messages exposing ( Msg(..) )
import Pages
import Transmutable.Html as Html
import Transmutable.Html.Attributes as A exposing ( class )
import Transmutable.Html.Events as E
import Views.Common as Common


layout page attributes contents =
    [ Html.section
        [ class "px-6 py-12 lg:flex md:px-8"
        ]
        [ -- -------------------------------------
          -- HEADER
          -- -------------------------------------
          Html.header
            [ class "mb-12 sm:mb-16 lg:mb-0 lg:flex-none lg:ml-12 lg:mr-36"
            ]
            [ Html.div
                [ class "flex flex-col items-end"
                ]
                [ Html.a
                    [ A.class "block mb-8 w-[98px]"
                    , A.attribute "aria-label" "Index"
                    , when page.route is
                        [ "404" ] ->
                            A.href "/"

                        _ ->
                            A.href
                                (Common.pathFromRoot
                                    { root = page.route
                                    }
                                    Pages.index.route
                                )
                    ]
                    [ Common.ikebana
                    ]
                , Common.tokonoma
                , Html.div
                    [ A.class "italic text-sm max-w-36 mt-5 text-right" ]
                    [ Html.text "Freelance web engineer, "
                    , Html.strong [] [ Html.text "available" ]
                    , Html.text " for contracts and part-time work."
                    ]
                ]

            , -- ----
              -- NAV
              -- ----
              let
                link linkPage =
                    let
                        firstPartRoute =
                            Array.first page.route

                        isActive =
                            firstPartRoute == Array.first linkPage.route
                    in
                    Html.div
                        [ A.class "inline-block lg:block lg:mb-4"
                        ]
                        [ Html.a
                            [ A.class "inline-block relative"
                            , A.target "_self"
                            , linkPage.route
                                |> Common.pathFromRoot
                                        { root = page.route
                                        }
                                |> (\r -> r ++ "/")
                                |> A.href
                            , E.preventDefaultOn
                                "click"
                                (Json.Decode.succeed
                                    { message = NavigateToPage linkPage
                                    , preventDefault = True
                                    }
                                )
                            ]
                            [ Html.text linkPage.name
                            , if isActive then
                                Html.span
                                    [ class ("mark bg-accent-" ++ Maybe.withDefault "" firstPartRoute)
                                    ]
                                    []
                              else
                                Html.text ""
                            ]
                        ]
              in
              Html.nav
                [ class "font-display mt-12 space-x-3 text-lg text-right md:space-x-6 md:text-xl lg:space-x-0"
                ]
                (Array.map link Pages.pages)
            ]

        , -- -------------------------------------
          -- MAIN
          -- -------------------------------------
          Html.main_
            (Array.prepend
                [ class "flex-1 max-w-2xl"
                ]
                attributes
            )
            contents
        ]
    ]
